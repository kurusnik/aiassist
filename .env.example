# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Session Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_random_secret_key_change_in_production

# Server
PORT=3000
NODE_ENV=development

# Database (если используете переменные окружения вместо хардкода)
DB_USER=testuser
DB_PASSWORD=tetstpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testdb

# Certbot (Let's Encrypt)
CERTBOT_EMAIL=admin@example.com

# Knowledge Diagnostics
KNOWLEDGE_DEBUG_MODE=false

# Context Intelligence
CI_QUALITY_THRESHOLD=0.15
CI_MAX_CONTEXT_CHARS=8000
CI_KNOWLEDGE_RESERVE=2000
CI_SCORE_WEIGHT=0.5
CI_SOURCE_WEIGHT=0.2

# Hybrid Retrieval
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_FTS_WEIGHT=0.4
HYBRID_MAX_RESULTS=10
HYBRID_VECTOR_THRESHOLD=0.15
HYBRID_VECTOR_LIMIT=10
HYBRID_FTS_LIMIT=10

# 1C MCP Server (RSV Data)
ONEC_MCP_ENABLED=false
ONEC_MCP_URL=http://192.168.0.6/UNF/hs/rsvdata/mcp
ONEC_MCP_LOGIN=your_1c_login
ONEC_MCP_PASSWORD=your_1c_password
