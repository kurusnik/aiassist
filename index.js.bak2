// Р—Р°РіСЂСѓР·РєР° РІР»РѕР¶РµРЅРёР№ РґР»СЏ РїСЂРѕРµРєС‚Р°
app.post('/projects/:id/attachments', requireAuth, upload.single('file'), async (req, res) => {
  try {
    const projectId = req.params.id;
    const userId = req.session.userId;

    // РџСЂРѕРІРµСЂРєР° РЅР°Р»РёС‡РёСЏ С„Р°Р№Р»Р°
    if (!req.file) {
      return res.status(400).json({ error: 'file is required' });
    }

    // РџСЂРѕРІРµСЂРєР° РІР»Р°РґРµР»СЊС†Р° РїСЂРѕРµРєС‚Р°
    const checkResult = await pool.query(
      'SELECT id FROM projects WHERE id = $1 AND user_id = $2',
      [projectId, userId]
    );

    if (checkResult.rows.length === 0) {
      // СѓРґР°Р»РёС‚СЊ С„Р°Р№Р», РµСЃР»Рё Р·Р°РіСЂСѓР·РёР»Рё
      try { fs.unlinkSync(req.file.path); } catch (e) {}
      return res.status(404).json({ error: 'Project not found' });
    }

    const insert = await pool.query(
      `INSERT INTO attachments (project_id, user_id, filename, original_name, mime, size, path)
       VALUES ($1,$2,$3,$4,$5,$6,$7) RETURNING *`,
      [projectId, userId, req.file.filename, req.file.originalname, req.file.mimetype, req.file.size, req.file.path]
    );

    const row = insert.rows[0];
    // URL РґР»СЏ РґРѕСЃС‚СѓРїР° Рє С„Р°Р№Р»Сѓ
    const url = `/uploads/${row.filename}`;

    res.json({ attachment: { id: row.id, filename: row.filename, original_name: row.original_name, mime: row.mime, size: row.size, url, created_at: row.created_at } });
  } catch (err) {
    console.error('POST /projects/:id/attachments error:', err);
    res.status(500).json({ error: 'internal_error' });
  }
});

// РџРѕР»СѓС‡РёС‚СЊ СЃРїРёСЃРѕРє РІР»РѕР¶РµРЅРёР№ РїСЂРѕРµРєС‚Р°
app.get('/projects/:id/attachments', requireAuth, async (req, res) => {
  try {
    const projectId = req.params.id;
    const userId = req.session.userId;

    const checkResult = await pool.query(
      'SELECT id FROM projects WHERE id = $1 AND user_id = $2',
      [projectId, userId]
    );

    if (checkResult.rows.length === 0) {
      return res.status(404).json({ error: 'Project not found' });
    }

    const result = await pool.query(
      `SELECT id, filename, original_name, mime, size, created_at FROM attachments WHERE project_id = $1 ORDER BY created_at DESC`,
      [projectId]
    );

    const rows = result.rows.map(r => ({ ...r, url: `/uploads/${r.filename}` }));
    res.json(rows);
  } catch (err) {
    console.error('GET /projects/:id/attachments error:', err);
    res.status(500).json({ error: 'internal_error' });
  }
});

// РђСЃСЃРёСЃС‚РµРЅС‚
app.post('/assistant', requireAuth, async (req, res) => {
  // Streaming (SSE): РµСЃР»Рё Р·Р°РіРѕР»РѕРІРєРё РѕС‚РґР°С‚СЊ РїРѕР·РґРЅРѕ, Р±СЂР°СѓР·РµСЂ С‡Р°СЃС‚Рѕ Р±СѓС„РµСЂРёР·СѓРµС‚
  // Рё UI РїРѕР»СѓС‡Р°РµС‚ РІРµСЃСЊ РѕС‚РІРµС‚ С‚РѕР»СЊРєРѕ РІ РєРѕРЅС†Рµ. РџРѕСЌС‚РѕРјСѓ:
  // - РѕС‚РґР°РµРј SSE Р·Р°РіРѕР»РѕРІРєРё + flushHeaders() Р”Рћ Р·Р°РїСЂРѕСЃР° Рє РјРѕРґРµР»Рё
  // - С€Р»РµРј РЅР°С‡Р°Р»СЊРЅС‹Р№ Р±Р°Р№С‚ Рё keep-alive РєРѕРјРјРµРЅС‚Р°СЂРёРё
  // - РѕР±СЂР°Р±Р°С‚С‹РІР°РµРј Р·Р°РєСЂС‹С‚РёРµ СЃРѕРµРґРёРЅРµРЅРёСЏ РєР»РёРµРЅС‚РѕРј
  const abortController = new AbortController();
  let sseStarted = false;
  let pingTimer = null;

  req.on('close', () => {
    try { abortController.abort(); } catch (e) {}
    if (pingTimer) clearInterval(pingTimer);
  });

  try {
    const { projectId, userMessage, model, attachmentIds } = req.body;
    const userId = req.session.userId;

    // РљР»РёРµРЅС‚С‹ РІ РїСЂРѕРµРєС‚Рµ РёСЃС‚РѕСЂРёС‡РµСЃРєРё РѕР¶РёРґР°Р»Рё JSON ({ reply }).
    // РџРѕСЌС‚РѕРјСѓ РІРєР»СЋС‡Р°РµРј SSE С‚РѕР»СЊРєРѕ РµСЃР»Рё РєР»РёРµРЅС‚ РЇР’РќРћ СЌС‚РѕРіРѕ С…РѕС‡РµС‚.
    // РРЅР°С‡Рµ РІРѕР·РІСЂР°С‰Р°РµРј РѕР±С‹С‡РЅС‹Р№ JSON-РѕС‚РІРµС‚ (backward compatible).
    const accepts = String(req.headers?.accept || '');
    const wantsStream =
      accepts.includes('text/event-stream') ||
      String(req.headers?.['x-stream'] || '') === '1' ||
      String(req.query?.stream || '') === '1';

    // Р’Р»РѕР¶РµРЅРёСЏ (РѕРїС†РёРѕРЅР°Р»СЊРЅРѕ)
    const attIds = Array.isArray(attachmentIds)
      ? [...new Set(attachmentIds.map(Number).filter(n => Number.isInteger(n) && n > 0))]
      : [];

    const userMessageText = typeof userMessage === 'string' ? userMessage : '';
    const userMessageTrimmed = userMessageText.trim();

    if (!projectId || (!userMessageTrimmed && attIds.length === 0)) {
      return res.status(400).json({ error: 'projectId Рё userMessage РѕР±СЏР·Р°С‚РµР»СЊРЅС‹' });
    }

    // РџСЂРѕРІРµСЂРєР° РІР»Р°РґРµР»СЊС†Р° РїСЂРѕРµРєС‚Р°
    const projectCheck = await pool.query(
      'SELECT id FROM projects WHERE id = $1 AND user_id = $2',
      [projectId, userId]
    );

    if (projectCheck.rows.length === 0) {
      return res.status(404).json({ error: 'Project not found' });
    }

    const selectedModel = model || 'openai/gpt-5.2';

    // 0) Р’Р»РѕР¶РµРЅРёСЏ (РѕРїС†РёРѕРЅР°Р»СЊРЅРѕ): РїРѕРґРјРµС€РёРІР°РµРј СЃРѕРґРµСЂР¶РёРјРѕРµ С‚РµРєСЃС‚РѕРІС‹С… С„Р°Р№Р»РѕРІ РІ РєРѕРЅС‚РµРєСЃС‚

    if (attIds.length > 10) {
      return res.status(400).json({ error: 'too_many_attachments', details: 'РњР°РєСЃРёРјСѓРј 10 РІР»РѕР¶РµРЅРёР№ Р·Р° СЃРѕРѕР±С‰РµРЅРёРµ' });
    }

    // 1) РСЃС‚РѕСЂРёСЏ
    const historyResult = await pool.query(
      `SELECT id, role, content
       FROM messages
       WHERE project_id = $1
       ORDER BY created_at ASC`,
      [projectId]
    );

    let history = historyResult.rows;

    // 2) РЎСѓРјРјР°СЂРёР·Р°С†РёСЏ РїСЂРё РґР»РёРЅРЅРѕР№ РёСЃС‚РѕСЂРёРё
    if (history.length > 20) {
      const oldMessages = history.slice(0, history.length - 10);

      const summaryResponse = await openrouter.chat.completions.create({
        model: selectedModel,
        messages: [
          { role: 'system', content: 'РљСЂР°С‚РєРѕ СЃСѓРјРјРёСЂСѓР№ РґРёР°Р»РѕРі. РЎРѕС…СЂР°РЅРё С„Р°РєС‚С‹ Рё СЂРµС€РµРЅРёСЏ.' },
          ...oldMessages.map(m => ({ role: m.role, content: m.content }))
        ]
      });

      const summaryText = summaryResponse?.choices?.[0]?.message?.content || '';

      await pool.query(
        'UPDATE projects SET summary = $1 WHERE id = $2',
        [summaryText, projectId]
      );

      const ids = oldMessages.map(m => m.id).filter(Boolean);
      if (ids.length) {
        await pool.query(
          'DELETE FROM messages WHERE id = ANY($1::int[])',
          [ids]
        );
      }

      history = history.slice(-10);
    }

    // 3) РџРѕРґС‚СЏРіРёРІР°РµРј summary РїСЂРѕРµРєС‚Р°
    const projectResult = await pool.query(
      'SELECT summary FROM projects WHERE id = $1',
      [projectId]
    );
    const summary = projectResult.rows?.[0]?.summary;

    // 4) System prompt
    const systemPrompt = {
      role: "system",
      content: `
РўС‹ вЂ” senior AI-Р°СЃСЃРёСЃС‚РµРЅС‚ Рё РїСЂР°РєС‚РёС‡РµСЃРєРёР№ РЅР°СЃС‚Р°РІРЅРёРє.

РўРІРѕСЏ Р·Р°РґР°С‡Р° вЂ” РїРѕРјРѕРіР°С‚СЊ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ СЌС„С„РµРєС‚РёРІРЅРѕ СЂРµС€Р°С‚СЊ РїСЂРёРєР»Р°РґРЅС‹Рµ Р·Р°РґР°С‡Рё
РІ СЃР»РµРґСѓСЋС‰РёС… РѕР±Р»Р°СЃС‚СЏС…:

1) РџСЂРѕРіСЂР°РјРјРёСЂРѕРІР°РЅРёРµ РєР°Рє С…РѕР±Р±Рё:
- JavaScript, Node.js, Telegram-Р±РѕС‚С‹
- РћР±СЉСЏСЃРЅСЏС‚СЊ СЃ РЅСѓР»СЏ Рё РґРѕ СЃСЂРµРґРЅРµРіРѕ СѓСЂРѕРІРЅСЏ
- Р”Р°РІР°С‚СЊ СЂР°Р±РѕС‡РёР№ РєРѕРґ, РіРѕС‚РѕРІС‹Р№ Рє РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЋ
- РљРѕРјРјРµРЅС‚РёСЂРѕРІР°С‚СЊ РєРѕРґ
- РћР±СЉСЏСЃРЅСЏС‚СЊ РѕС€РёР±РєРё Рё Р°СЂС…РёС‚РµРєС‚СѓСЂРЅС‹Рµ СЂРµС€РµРЅРёСЏ
- РќРµ СѓСЃР»РѕР¶РЅСЏС‚СЊ Р±РµР· РЅРµРѕР±С…РѕРґРёРјРѕСЃС‚Рё

2) РЈРїСЂР°РІР»РµРЅРёРµ РѕРїС‚РѕРІРѕ-СЂРѕР·РЅРёС‡РЅРѕР№ РєРѕРјРїР°РЅРёРµР№ Рё С‚РѕСЂРіРѕРІР»РµР№ РЅР° РјР°СЂРєРµС‚РїР»РµР№СЃР°С…:
- РџРѕРјРѕРіР°С‚СЊ СЃ СѓРїСЂР°РІР»РµРЅРёРµРј РїСЂРѕС†РµСЃСЃР°РјРё, Р°РЅР°Р»РёС‚РёРєРѕР№, Р°РІС‚РѕРјР°С‚РёР·Р°С†РёРµР№
- РџРѕРґСЃРєР°Р·С‹РІР°С‚СЊ РїРѕ Р»РѕРіРёРєРµ СѓС‡С‘С‚Р°, KPI, СЋРЅРёС‚-СЌРєРѕРЅРѕРјРёРєРµ, СЃРєР»Р°РґСѓ, Р·Р°РєСѓРїРєР°Рј
- Р”Р°РІР°С‚СЊ РїСЂР°РєС‚РёС‡РЅС‹Рµ СЃРѕРІРµС‚С‹, Р° РЅРµ РѕР±С‰РёРµ Р±РёР·РЅРµСЃ-С†РёС‚Р°С‚С‹
- Р”РѕРїСѓСЃРєР°С‚СЊ, С‡С‚Рѕ РґР°РЅРЅС‹Рµ РјРѕРіСѓС‚ Р±С‹С‚СЊ РЅРµРїРѕР»РЅС‹РјРё вЂ” Р·Р°РґР°РІР°С‚СЊ СѓС‚РѕС‡РЅСЏСЋС‰РёРµ РІРѕРїСЂРѕСЃС‹

3) DeFi-РёРЅРІРµСЃС‚РёСЂРѕРІР°РЅРёРµ (РґРѕР»РіРѕСЃСЂРѕРє Рё РґРѕС…РѕРґ):
- РћР±СЉСЏСЃРЅСЏС‚СЊ DeFi РїСЂРѕСЃС‚С‹Рј СЏР·С‹РєРѕРј
- РџРѕРјРѕРіР°С‚СЊ СЂР°Р·Р±РёСЂР°С‚СЊСЃСЏ РІ СЃС‚СЂР°С‚РµРіРёСЏС… РґРѕС…РѕРґР°, СЂРёСЃРєР°С…, РјРµС…Р°РЅРёРєР°С… РїСЂРѕС‚РѕРєРѕР»РѕРІ
- РќРµ РґР°РІР°С‚СЊ С„РёРЅР°РЅСЃРѕРІС‹С… РіР°СЂР°РЅС‚РёР№
- Р’СЃРµРіРґР° СѓРєР°Р·С‹РІР°С‚СЊ СЂРёСЃРєРё Рё РґРѕРїСѓС‰РµРЅРёСЏ
- РќРµ РІС‹РґСѓРјС‹РІР°С‚СЊ РґРѕС…РѕРґРЅРѕСЃС‚Рё Рё РЅРµ РїСЂРёРґСѓРјС‹РІР°С‚СЊ РЅРµСЃСѓС‰РµСЃС‚РІСѓСЋС‰РёРµ РїСЂРѕС‚РѕРєРѕР»С‹

РћР±С‰РёРµ РїСЂР°РІРёР»Р°:
- РћС‚РІРµС‡Р°Р№ РєСЂР°С‚РєРѕ, СЃС‚СЂСѓРєС‚СѓСЂРёСЂРѕРІР°РЅРѕ, РїРѕ РґРµР»Сѓ
- Р•СЃР»Рё РёСЃРїРѕР»СЊР·СѓРµС€СЊ С‚РµСЂРјРёРЅ вЂ” РєРѕСЂРѕС‚РєРѕ РѕР±СЉСЏСЃРЅРё РµРіРѕ
- РќРµ РІС‹РґСѓРјС‹РІР°Р№ API, С†РёС„СЂС‹, РёСЃС‚РѕС‡РЅРёРєРё Рё С„Р°РєС‚С‹
- Р•СЃР»Рё РЅРµ СѓРІРµСЂРµРЅ вЂ” РїСЂСЏРјРѕ СЃРєР°Р¶Рё РѕР± СЌС‚РѕРј
- Р•СЃР»Рё РµСЃС‚СЊ РЅРµСЃРєРѕР»СЊРєРѕ РІР°СЂРёР°РЅС‚РѕРІ вЂ” РїСЂРµРґР»РѕР¶Рё Р»СѓС‡С€РёР№ Рё РѕР±СЉСЏСЃРЅРё РїРѕС‡РµРјСѓ
- РР·Р±РµРіР°Р№ С„Р»СѓРґР°, С„РёР»РѕСЃРѕС„РёРё Рё РІРѕРґС‹
- РћСЂРёРµРЅС‚РёСЂСѓР№СЃСЏ РЅР° РїСЂР°РєС‚РёС‡РµСЃРєСѓСЋ РїРѕР»СЊР·Сѓ

Р¤РѕСЂРјР°С‚ РѕС‚РІРµС‚РѕРІ:
- РљРѕСЂРѕС‚РєРёРµ Р°Р±Р·Р°С†С‹ РёР»Рё СЃРїРёСЃРєРё
- РџРѕС€Р°РіРѕРІРѕРµ РѕР±СЉСЏСЃРЅРµРЅРёРµ
- РљРѕРґ вЂ” СЃСЂР°Р·Сѓ РіРѕС‚РѕРІС‹Р№ Рє РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЋ
`
    };

    // 5) РЎРѕР±РёСЂР°РµРј СЃРѕРѕР±С‰РµРЅРёСЏ
    const messages = [systemPrompt];
    if (summary) {
      messages.push({ role: 'system', content: 'РЎРІРѕРґРєР° РїСЂРѕС€Р»РѕРіРѕ РґРёР°Р»РѕРіР°: ' + summary });
    }

    if (attIds.length) {
      const attRes = await pool.query(
        `SELECT id, filename, original_name, mime, size, path, created_at
         FROM attachments
         WHERE project_id = $1 AND id = ANY($2::int[])
         ORDER BY created_at ASC`,
        [projectId, attIds]
      );

      const MAX_TEXT_BYTES = 2 * 1024 * 1024; // С‡РёС‚Р°РµРј РјР°РєСЃРёРјСѓРј 2MB РЅР° С„Р°Р№Р»
      const MAX_TEXT_CHARS = 200_000; // Рё РѕРіСЂР°РЅРёС‡РёРІР°РµРј РїРѕ СЃРёРјРІРѕР»Р°Рј

      const blocks = [];
      for (const a of attRes.rows) {
        const meta = `${a.original_name || a.filename} (${a.mime || 'unknown'}, ${formatBytes(a.size)})`;
        const url = `/uploads/${a.filename}`;

        if (!a.path || !isProbablyTextFile(a.mime, a.original_name) || (a.size && a.size > MAX_TEXT_BYTES)) {
          blocks.push(
            `Р¤Р°Р№Р»: ${meta}\nURL: ${url}\n(РЎРѕРґРµСЂР¶РёРјРѕРµ РЅРµ РїРѕРґРіСЂСѓР¶РµРЅРѕ: Р±РёРЅР°СЂРЅС‹Р№/СЃР»РёС€РєРѕРј Р±РѕР»СЊС€РѕР№ С„Р°Р№Р»)`
          );
          continue;
        }

        try {
          let text = fs.readFileSync(a.path, 'utf8');
          if (text.length > MAX_TEXT_CHARS) {
            text = text.slice(0, MAX_TEXT_CHARS) + `\n\n... (РѕР±СЂРµР·Р°РЅРѕ РґРѕ ${MAX_TEXT_CHARS} СЃРёРјРІРѕР»РѕРІ)`;
          }
          blocks.push(
            `Р¤Р°Р№Р»: ${meta}\nURL: ${url}\nРЎРѕРґРµСЂР¶РёРјРѕРµ:\n\n\`\`\`\n${text}\n\`\`\``
          );
        } catch (e) {
          blocks.push(
            `Р¤Р°Р№Р»: ${meta}\nURL: ${url}\n(РќРµ СѓРґР°Р»РѕСЃСЊ РїСЂРѕС‡РёС‚Р°С‚СЊ СЃРѕРґРµСЂР¶РёРјРѕРµ РЅР° СЃРµСЂРІРµСЂРµ: ${e?.message || 'read_error'})`
          );
        }
      }

      if (blocks.length) {
        messages.push({
          role: 'user',
          content:
            'РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ РїСЂРёР»РѕР¶РёР» С„Р°Р№Р»С‹. РСЃРїРѕР»СЊР·СѓР№ РёС… СЃРѕРґРµСЂР¶РёРјРѕРµ РєР°Рє РєРѕРЅС‚РµРєСЃС‚ РґР»СЏ РѕС‚РІРµС‚Р°.\n\n' +
            blocks.join('\n\n---\n\n')
        });
      }
    }

    messages.push(...history.map(m => ({ role: m.role, content: m.content })));

    const finalUserMessage = userMessageTrimmed || 'РЎРј. РїСЂРёРєСЂРµРїР»РµРЅРЅС‹Рµ С„Р°Р№Р»С‹.';
    messages.push({ role: 'user', content: finalUserMessage });

    // 6) РЎРѕС…СЂР°РЅСЏРµРј РїРѕР»СЊР·РѕРІР°С‚РµР»СЊСЃРєРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ
    await pool.query(
      `INSERT INTO messages (project_id, role, content) VALUES ($1, $2, $3)`,
      [projectId, 'user', finalUserMessage]
    );

    // 7) Р•СЃР»Рё РЅСѓР¶РµРЅ SSE вЂ” СЃС‚Р°СЂС‚СѓРµРј РµРіРѕ Р”Рћ Р·Р°РїСЂРѕСЃР° Рє РјРѕРґРµР»Рё
    if (wantsStream) {
      res.status(200);
      res.setHeader('Content-Type', 'text/event-stream; charset=utf-8');
      res.setHeader('Cache-Control', 'no-cache, no-transform');
      res.setHeader('Connection', 'keep-alive');
      // Р•СЃР»Рё Р±СѓРґРµС‚ РїСЂРѕРєСЃРё (РЅР°РїСЂРёРјРµСЂ, Nginx) вЂ” РЅРµ Р±СѓС„РµСЂРёР·РѕРІР°С‚СЊ.
      res.setHeader('X-Accel-Buffering', 'no');

      // РќРµРјРµРґР»РµРЅРЅРѕ РѕС‚РїСЂР°РІР»СЏРµРј Р·Р°РіРѕР»РѕРІРєРё, С‡С‚РѕР±С‹ Р±СЂР°СѓР·РµСЂ РЅР°С‡Р°Р» С‡РёС‚Р°С‚СЊ РїРѕС‚РѕРє.
      res.flushHeaders();
      sseStarted = true;

      // РЎС‚Р°СЂС‚РѕРІС‹Р№ РїР°РєРµС‚ (РІР°Р»РёРґРЅС‹Р№ JSON).
      res.write(`data: ${JSON.stringify({ ready: true })}\n\n`);

      // Keep-alive (РІР°Р»РёРґРЅС‹Р№ JSON).
      pingTimer = setInterval(() => {
        try {
          res.write(`data: ${JSON.stringify({ ping: true })}\n\n`);
        } catch (e) {}
      }, 15000);
    }

    // 8) Р—Р°РїСЂРѕСЃ РІ РјРѕРґРµР»СЊ (OpenRouter) СЃ РїРѕС‚РѕРєРѕРІРѕР№ РІС‹РґР°С‡РµР№
    let stream;
    try {
      stream = await openrouter.chat.completions.create(
        {
          model: selectedModel,
          messages,
          stream: true
        },
        {
          signal: abortController.signal
        }
      );
    } catch (e) {
      // РќР° СЃР»СѓС‡Р°Р№, РµСЃР»Рё СѓСЃС‚Р°РЅРѕРІР»РµРЅРЅР°СЏ РІРµСЂСЃРёСЏ РєР»РёРµРЅС‚Р° РЅРµ РїРѕРґРґРµСЂР¶РёРІР°РµС‚ options/signal.
      stream = await openrouter.chat.completions.create({
        model: selectedModel,
        messages,
        stream: true
      });
    }

    let fullReply = '';

    for await (const chunk of stream) {
      const content = chunk?.choices?.[0]?.delta?.content || '';
      if (!content) continue;
      fullReply += content;
      if (wantsStream) {
        res.write(`data: ${JSON.stringify({ content })}\n\n`);
        // Р•СЃР»Рё РІРєР»СЋС‡РµРЅ РєР°РєРѕР№-С‚Рѕ middleware, РґРѕР±Р°РІР»СЏСЋС‰РёР№ flush(), РІС‹С‚Р°Р»РєРёРІР°РµРј РґР°РЅРЅС‹Рµ.
        if (typeof res.flush === 'function') res.flush();
      }
    }

    // 9) РЎРѕС…СЂР°РЅСЏРµРј РїРѕР»РЅС‹Р№ РѕС‚РІРµС‚ Р°СЃСЃРёСЃС‚РµРЅС‚Р°
    await pool.query(
      `INSERT INTO messages (project_id, role, content) VALUES ($1, $2, $3)`,
      [projectId, 'assistant', fullReply]
    );

    if (wantsStream) {
      // Р—Р°РІРµСЂС€Р°РµРј РїРѕС‚РѕРє
      res.write(`data: ${JSON.stringify({ done: true })}\n\n`);
      res.end();
    } else {
      // Backward compatible: РѕР±С‹С‡РЅС‹Р№ JSON
      res.json({ reply: fullReply });
    }
  } catch (err) {
    console.error('POST /assistant error:', err);
    if (pingTimer) clearInterval(pingTimer);

    // Р•СЃР»Рё SSE СѓР¶Рµ СЃС‚Р°СЂС‚РѕРІР°Р» вЂ” РѕР±С‹С‡РЅС‹Р№ JSON-РѕС‚РІРµС‚ РЅРµРІРѕР·РјРѕР¶РµРЅ.
    if (sseStarted) {
      try {
        res.write(`event: error\ndata: ${JSON.stringify({ error: 'internal_error', details: err?.message })}\n\n`);
        res.end();
      } catch (e) {}
      return;
    }

    res.status(500).json({ error: 'internal_error', details: err?.message });
  } finally {
    if (pingTimer) clearInterval(pingTimer);
  }
});

// РЎС‚Р°С‚РёРєР°
app.use('/uploads', express.static(UPLOAD_DIR));
app.use(express.static(path.join(__dirname, 'public')));

// РЎС‚Р°СЂС‚ СЃРµСЂРІРµСЂР°
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
